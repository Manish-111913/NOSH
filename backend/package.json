{
  "name": "nosh-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Nosh dish management API (Express + PostgreSQL)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "start:render": "npm run db:migrate && npm run db:seed && npm start",
    "start:e2e": "node scripts/migrate.js && node scripts/reset.js --yes && node src/server.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "db:reset": "node scripts/reset.js",
    "test": "vitest run"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "supertest": "^7.3.1",
    "vitest": "^5.0.4"
  }
}
