# Copy to backend/.env for local development. Placeholder/local-only values, no real secrets.

NODE_ENV=development
PORT=4729

# Local Docker database (see docker-compose.yml in the repository root).
DATABASE_URL=postgresql://nosh:nosh_local_password@localhost:54329/nosh

# Set to true only if your database requires SSL (e.g. Render's *external* connection string).
DATABASE_SSL=false

# Comma-separated frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5729

# Dedicated database used by `npm test`. Its name must end with "_test"; tests wipe it.
TEST_DATABASE_URL=postgresql://nosh:nosh_local_password@localhost:54329/nosh_test
